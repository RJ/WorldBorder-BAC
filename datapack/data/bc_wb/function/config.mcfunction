function bc_wb:version
tellraw @s [{"text": "["}, {"text": "★", "color": "yellow"}, {"text": "] "}, {"translate": "Set WorldBorder position", "color": "yellow", "hover_event": {"action": "show_text", "value": {"translate": "Click to set", "color": "gold"}}, "click_event": {"action": "suggest_command", "command": "/worldborder center "}}, {"text": "\n["}, {"text": "☄", "color": "light_purple"}, {"text": "] "}, {"translate": "Remove all advancements and start", "color": "light_purple", "hover_event": {"action": "show_text", "value": {"translate": "This is remove all advencements all players and reset WorldBorder to 1 block!!!", "color": "gold"}}, "click_event": {"action": "run_command", "command": "/function bc_wb:config/startmsg"}}, {"text": "\n"}, {"text": "["}, {"text": "🔥", "color": "gold"}, {"text": "]"}, {"text": " ", "color": "gray"}, {"translate": "Start WorldBorder", "color": "red", "hover_event": {"action": "show_text", "value": {"translate": "Click to start the WorldBorder", "color": "gold"}}, "click_event": {"action": "run_command", "command": "/function bc_wb:config/startmsgadv"}}]
execute if score fast_wb wb_config matches 0 run tellraw @s [{"text": "["}, {"text": "⚡", "color": "#EEE8FF"}, {"text": "] "}, {"text": "Switch to fast-mode", "color": "#FFE8FF", "hover_event": {"action": "show_text", "value": {"text": "In this mode, the world border will increase instantly", "color": "#FEEBFE"}}, "click_event": {"action": "run_command", "command": "/function bc_wb:config/switch/fast_mode"}}]
execute if score fast_wb wb_config matches 1 run tellraw @s [{"text": "["}, {"text": "⌚", "color": "#EEE8FF"}, {"text": "] "}, {"text": "Switch to normal-mode", "color": "#FFE8FF", "hover_event": {"action": "show_text", "value": {"text": "In this mode, the world border will increase gradually", "color": "#FEEBFE"}}, "click_event": {"action": "run_command", "command": "/function bc_wb:config/switch/normal_mode"}}]
execute if score bossbar wb_config matches 0 run tellraw @s [{"text": "["}, {"text": "⏻", "color": "red"}, {"text": "] "}, {"translate": "Show Bossbar with Border Diameter", "color": "#8dd9bf", "hover_event": {"action": "show_text", "value": {"translate": "In this mode, you will have the bossbar with world radius", "color": "#8dd9bf"}}, "click_event": {"action": "run_command", "command": "/function bc_wb:config/switch/bossbar_on"}}]
execute if score bossbar wb_config matches 1 run tellraw @s [{"text": "["}, {"text": "⏻", "color": "green"}, {"text": "] "}, {"translate": "Hide Bossbar with Border Diameter", "color": "#8dd9bf", "hover_event": {"action": "show_text", "value": {"translate": "In this mode, you won't have the bossbar with world radius", "color": "#8dd9bf"}}, "click_event": {"action": "run_command", "command": "/function bc_wb:config/switch/bossbar_off"}}]
tellraw @s {"text": "Players also can see World Size with /trigger wb_world_size", "color": "gray"}
